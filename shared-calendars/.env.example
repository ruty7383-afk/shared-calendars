# העתיקי לקובץ בשם .env ומלאי ערכים
PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/shared_calendars
# true כשמתחברים למסד נתונים בענן (Render, Railway, Neon וכו')
DATABASE_SSL=false
# מחרוזת אקראית ארוכה (לפחות 32 תווים)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# הכתובת של אתר ה-React. * מתאים לפיתוח בלבד
CORS_ORIGIN=*
# מסד נפרד לבדיקות (בדיקות האינטגרציה מוחקות בו נתונים!)
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/shared_calendars_test

# תמונות נשמרות ב-Cloudinary (cloudinary.com, חשבון חינמי). הערכים ב-Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
